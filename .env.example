# Discord Bot 環境變數
# 從 https://discord.com/developers/applications 取得

DISCORD_TOKEN=你的Bot_Token
CLIENT_ID=你的應用程式ID
GOOGLE_AI_KEY=你的Google_AI_Studio金鑰
AI_ADMIN_PASSWORD=你的AI管理密碼
PORT=3000

# 選用：月下樂藏 NAS 音樂庫服務位址；各使用者從 Discord 私人介面登入。
# 同 NAS、預設 port 且 bot 使用 host network 時可用 http://127.0.0.1:8480。
# MUSIC_API_BASE_URL=http://127.0.0.1:8480
# Docker 已安裝 FFmpeg；本機可選擇指定執行檔路徑。
# MUSIC_FFMPEG_PATH=ffmpeg
# YouTube 點播：Docker 已內建固定版本 yt-dlp；本機需安裝官方 standalone。
# 未設定 NAS 服務仍可使用 YouTube；工具缺失時僅停用 YouTube 入口。
# MUSIC_YTDLP_PATH=yt-dlp

# 選用：僅供開發預覽。正式全域同步及清理殘留指令時請保持註解。
# GUILD_ID=你的測試伺服器ID
